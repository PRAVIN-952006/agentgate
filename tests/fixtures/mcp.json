{
  "mcpServers": {
    "filesystem": {
      "command": "python",
      "args": ["server.py"],
      "env": {
        "API_TOKEN": "redacted-at-review-time"
      },
      "tools": [
        {
          "name": "read_file",
          "description": "Read a file",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {"type": "string"}
            },
            "required": ["path"]
          }
        }
      ]
    }
  }
}
